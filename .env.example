# Copy to .env locally and fill in real values. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/notification_hub
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
APP_ENV=development
SESSION_COOKIE_SECURE=false
NEXORA_ALLOW_INSECURE_COOKIES=true
# Local development only; remove/disable for HTTPS deployments.
NEXORA_ALLOW_INSECURE_OAUTH=1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/oauth/google/callback
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=security@example.com
APP_BASE_URL=http://127.0.0.1:5000
MONITOR_INTERVAL_MINUTES=5
